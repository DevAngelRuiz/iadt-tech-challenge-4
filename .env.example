# API OpenAI opcional para relatório; Whisper local não exige chave
OPENAI_API_KEY=

# AWS (Textract / Comprehend) — opcional; sem credenciais usa fallback local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Caminhos
YOLO_WEIGHTS=models/bleeding_yolov8n.pt
OUTPUT_DIR=outputs

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_LANGUAGE_KEY=
AZURE_LANGUAGE_ENDPOINT=
SPEECH_PROVIDER=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_CACHE_DIR=models/whisper
NLP_PROVIDER=local
QWEN_BASE_URL=http://127.0.0.1:8081/v1
QWEN_MODEL=qwen2.5-1.5b-instruct
REPORT_PROVIDER=local
